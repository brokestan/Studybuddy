# --- Groq (free LLM) ---
# Key: https://console.groq.com/keys
GROQ_API_KEY=
# Groq retires models often. Current default is below; if calls start returning
# 404 "model not found", check https://console.groq.com/docs/deprecations and
# put the replacement id here (no redeploy of code needed).
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Walrus Memory / MemWal (mainnet) ---
# Both from https://memory.walrus.xyz . The private key is a SERVER SECRET:
# never NEXT_PUBLIC_, never committed, never sent to the browser.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# --- Supabase (free) — ONLY needed for the Study Room (group chat) ---
# Supabase -> Project Settings -> API. Use the *service_role* key (server secret).
# Then run supabase/schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables POST /api/dev/isolation-test (evidence for your article).
# ENABLE_DEV_TESTS=true
